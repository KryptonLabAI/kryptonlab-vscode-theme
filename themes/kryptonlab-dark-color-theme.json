    "variable.readonly": "#F59E0B",
    "property": "#0EA5E9",
    "property.readonly": "#F59E0B",
    "enumMember": "#10B981",
    "event": "#F59E0B",
    "function": "#7C54F8",
    "method": "#7C54F8",
    "macro": "#B99CFF",
