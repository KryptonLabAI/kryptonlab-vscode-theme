    "operator": "#B2B8F6",
    "decorator": "#F59E0B",
    "label": "#0EA5E9",
    "*.deprecated": "#5A5E8C"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5A5E8C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment",
      "scope": [
        "comment.block.documentation",
        "comment.block.documentation storage.type.class"
      ],
      "settings": {
        "foreground": "#6E72A0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#10B981"
      }
    },
    {
      "name": "String escapes",
      "scope": [
        "constant.character.escape",
        "constant.character.entity",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#F59E0B"
      }
    },
    {
      "name": "String regexp",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#EF4444"
      }
    },
    {
      "name": "Number / constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "support.constant"
      ],
      "settings": {
        "foreground": "#F59E0B"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#B99CFF"
      }
    },
    {
      "name": "Keyword operator / punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#B2B8F6"
      }
    },
    {
      "name": "Operators (arithmetic/logic)",
      "scope": [
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.comparison",
        "keyword.operator.assignment"
      ],
      "settings": {
        "foreground": "#9A7CFF"
      }
    },
    {
      "name": "Function / method",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#7C54F8"
      }
    },
    {
      "name": "Class / type / enum",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.class",
        "support.type",
        "entity.name.type.class",
        "entity.name.type.enum",
        "support.type.primitive"
      ],
      "settings": {
        "foreground": "#B99CFF"
      }
    },
    {
      "name": "Interface / struct / trait",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.struct",
        "entity.name.type.trait",
        "storage.type.interface",
        "storage.type.struct"
      ],
      "settings": {
        "foreground": "#B99CFF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Interface name",
      "scope": [
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#CBBFE4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Namespace / module",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "storage.modifier.import",
        "storage.modifier.package"
      ],
      "settings": {
        "foreground": "#B2B8F6"
      }
    },
    {
      "name": "Variable / parameter",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other",
        "meta.definition.variable.name",
        "variable.other.readwrite",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#C9CDF9"
      }
    },
    {
      "name": "Language constant / readonly variable",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember",
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#F59E0B"
      }
    },
    {
      "name": "Property / attribute",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.other.attribute-name",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#0EA5E9"
      }
    },
    {
      "name": "CSS class / id selector",
      "scope": [
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#B99CFF"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "meta.tag",
